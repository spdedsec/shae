// Pure-Shae Zero-Copy Typed Memory Buffers & Struct Layouts Suite Test
// tests/shae/buffer_suite_test.shae
// Validates std:buffer allocation, zero-copy slicing, endian I/O, struct pack/unpack, and dual-engine parity.

use { test, assert, assert_eq, assert_ne, assert_throws } from "std:test"
use {
    ByteBuffer,
    alloc,
    from_hex,
    fromHex,
    from_utf8,
    fromUtf8,
    concat,
    pack,
    pack_into,
    packInto,
    unpack,
    unpack_from,
    unpackFrom,
    calcsize,
    calcSize
} from "std:buffer"

let buffer = use "std:buffer"

test("ByteBuffer allocation, direct indexing, length, and offset", fn() {
    let buf = alloc(32)
    assert_eq(buf.len, 32)
    assert_eq(buf.offset, 0)

    // Direct byte write and read
    buf[0] = 65
    buf[31] = 90
    assert_eq(buf[0], 65)
    assert_eq(buf[31], 90)

    // Element value validation (must be 0..255)
    assert_throws(fn() {
        buf[0] = 300
    }, "Byte write > 255 must throw")

    assert_throws(fn() {
        buf[0] = -5
    }, "Byte write < 0 must throw")

    // Out of bounds read/write
    assert_throws(fn() {
        let x = buf[32]
    }, "Read beyond length must throw")

    assert_throws(fn() {
        buf[32] = 10
    }, "Write beyond length must throw")
});

test("Zero-copy buffer slicing shares underlying memory", fn() {
    let parent = alloc(20)
    let i = 0
    while i < 20 {
        parent[i] = i * 2
        i = i + 1
    }

    // Zero-copy slice from index 5 to 15 (length 10)
    let slice1 = parent.slice(5, 15)
    assert_eq(slice1.len, 10)
    assert_eq(slice1.offset, 5)
    assert_eq(slice1[0], 10) // parent[5] = 10
    assert_eq(slice1[9], 28) // parent[14] = 28

    // Mutating slice must reflect immediately in parent (zero-copy)
    slice1[0] = 255
    assert_eq(parent[5], 255, "Parent must observe slice mutation")

    // Mutating parent must reflect immediately in slice (zero-copy)
    parent[6] = 123
    assert_eq(slice1[1], 123, "Slice must observe parent mutation")

    // Deep copy creates independent storage
    let cloned = slice1.copy()
    cloned[0] = 42
    assert_eq(slice1[0], 255, "Deep-copied buffer must not mutate original slice")
    assert_eq(parent[5], 255, "Deep-copied buffer must not mutate parent")
});

test("Hex, UTF-8, and byte array conversions", fn() {
    let hex_str = "0102030405060708"
    let b_hex = from_hex(hex_str)
    assert_eq(b_hex.len, 8)
    assert_eq(b_hex.to_hex(), hex_str)

    let greeting = "Hello, Shae Typed Buffers!"
    let b_utf8 = from_utf8(greeting)
    assert_eq(b_utf8.to_utf8(), greeting)

    let b_arr = buffer.from([10, 20, 30, 40])
    let byte_list = b_arr.to_bytes()
    assert_eq(byte_list.len, 4)
    assert_eq(byte_list[0], 10)
    assert_eq(byte_list[3], 40)

    // Buffer equality with byte array
    assert(b_arr == [10, 20, 30, 40])
    assert([10, 20, 30, 40] == b_arr)
    assert(b_arr != [10, 20, 30, 41])
});

test("Buffer concatenation", fn() {
    let b1 = from_utf8("Shae ")
    let b2 = from_utf8("Buffer ")
    let b3 = from_utf8("Engine")

    let merged = concat([b1, b2, b3])
    assert_eq(merged.to_utf8(), "Shae Buffer Engine")
    assert_eq(merged.len, b1.len + b2.len + b3.len)
});

test("Endian-aware numeric reads and writes (u8-u64, i8-i64, f32, f64)", fn() {
    let b = alloc(64)

    // u8 and i8
    b.write_u8(0, 254)
    b.write_i8(1, -120)
    assert_eq(b.read_u8(0), 254)
    assert_eq(b.read_i8(1), -120)

    // u16 LE and BE
    b.write_u16_le(2, 45000)
    b.write_u16_be(4, 45000)
    assert_eq(b.read_u16_le(2), 45000)
    assert_eq(b.read_u16_be(4), 45000)
    assert_ne(b[2], b[4], "Endianness must produce different byte order")

    // i16 LE and BE
    b.write_i16_le(6, -24000)
    b.write_i16_be(8, -24000)
    assert_eq(b.read_i16_le(6), -24000)
    assert_eq(b.read_i16_be(8), -24000)

    // u32 LE and BE
    b.write_u32_le(10, 3500000000)
    b.write_u32_be(14, 3500000000)
    assert_eq(b.read_u32_le(10), 3500000000)
    assert_eq(b.read_u32_be(14), 3500000000)

    // i32 LE and BE
    b.write_i32_le(18, -1500000000)
    b.write_i32_be(22, -1500000000)
    assert_eq(b.read_i32_le(18), -1500000000)
    assert_eq(b.read_i32_be(22), -1500000000)

    // u64 and i64
    b.write_u64_le(26, 8000000000000000)
    b.write_i64_be(34, -7000000000000000)
    assert_eq(b.read_u64_le(26), 8000000000000000)
    assert_eq(b.read_i64_be(34), -7000000000000000)

    // f32 and f64
    b.write_f32_le(42, 12.5)
    b.write_f64_be(46, 12345.6789)
    assert_eq(b.read_f32_le(42), 12.5)

    // CamelCase aliases
    b.writeU32LE(54, 11223344)
    assert_eq(b.readU32LE(54), 11223344)
});

test("Struct packing, unpacking, and calcsize (<I2h4s and >2d4B)", fn() {
    // Format calcsize
    assert_eq(calcsize("<I2h4s"), 12)
    assert_eq(calcsize(">2d4B"), 20)
    assert_eq(calcSize("3x"), 3)

    // Pack with variadic arguments
    let p1 = pack("<I2h4s", 4000000000, -500, 1500, "CODE")
    assert_eq(p1.len, 12)

    let u1 = unpack("<I2h4s", p1)
    assert_eq(u1.len, 4)
    assert_eq(u1[0], 4000000000)
    assert_eq(u1[1], -500)
    assert_eq(u1[2], 1500)
    assert_eq(u1[3], "CODE")

    // Pack with array argument
    let p2 = pack("<I2h4s", [123456, 100, 200, "SHAE"])
    let u2 = unpack("<I2h4s", p2)
    assert_eq(u2[0], 123456)
    assert_eq(u2[3], "SHAE")

    // Big-Endian pack/unpack
    let p3 = pack(">2d4B", 1.5, 2.5, 10, 20, 30, 40)
    assert_eq(p3.len, 20)
    let u3 = unpack(">2d4B", p3)
    assert_eq(u3.len, 6)
    assert_eq(u3[0], 1.5)
    assert_eq(u3[1], 2.5)
    assert_eq(u3[2], 10)
    assert_eq(u3[5], 40)

    // pack_into and unpack with offset
    let target_buf = alloc(32)
    let written = pack_into("<I2h4s", target_buf, 8, 999999, -42, 42, "INTO")
    assert_eq(written, 12)

    let u_offset = unpack("<I2h4s", target_buf, 8)
    assert_eq(u_offset[0], 999999)
    assert_eq(u_offset[1], -42)
    assert_eq(u_offset[2], 42)
    assert_eq(u_offset[3], "INTO")
});
