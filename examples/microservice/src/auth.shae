use { sha256, hmac_sha256, uuid_v4 } from "std:crypto"
use { b64_url_encode, b64_url_decode } from "std:codec"
use { split } from "std:regex"
let SERVER_SECRET = "shae_showcase_master_key_2026"

fn hash_password(password) {
    return sha256(password + SERVER_SECRET)
}

fn create_auth_token(user_id, username) {
    let payload = json_stringify({ id: user_id, user: username, nonce: uuid_v4() })
    let encoded = b64_url_encode(payload)
    let sig = hmac_sha256(SERVER_SECRET, encoded)
    return encoded + "." + sig
}

fn verify_auth_token(token) {
    if token == null {
        return { valid: false, error: "Missing authorization token" }
    }
    let parts = split("\\.", token)
    if len(parts) != 2 {
        return { valid: false, error: "Malformed token format" }
    }
    let encoded_payload = parts[0]
    let provided_sig = parts[1]
    let expected_sig = hmac_sha256(SERVER_SECRET, encoded_payload)
    if provided_sig != expected_sig {
        return { valid: false, error: "Invalid token signature" }
    }
    let raw_json = b64_url_decode(encoded_payload)
    let payload = json_parse(raw_json)
    return { valid: true, payload: payload }
}
