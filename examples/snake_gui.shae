#!/usr/bin/env shae
# ==============================================================================
#  SHAE RETRO SNAKE — 60 FPS Native Graphical Game in Pure Shae
# ==============================================================================
#  Created for the Shae Language & Compiler Project
#  Controls: Arrow Keys or [W][A][S][D] to Move | [R] to Restart | [ESC] to Exit
# ==============================================================================

let gui = use "std:gui"
let rand = use "std:random"

println("=========================================================")
println(" 🐍 Launching SHAE RETRO SNAKE (60 FPS Native GUI Engine)")
println(" Controls: [W][A][S][D] or Arrows to steer, [R] to retry")
println("=========================================================")

let win = gui.window("Shae Retro Snake", 600, 600)

let snake_x = [15, 14, 13]
let snake_y = [15, 15, 15]
let dir_x = 1
let dir_y = 0
let next_dir_x = 1
let next_dir_y = 0

let food_x = rand.int(2, 27)
let food_y = rand.int(4, 27)

let score = 0
let high_score = 0
let game_over = false
let frame = 0
let move_interval = 7

while gui.is_open(win) {
    frame = frame + 1

    # 1. Process Player Input
    if (gui.is_key_down(win, "Up") || gui.is_key_down(win, "W")) && dir_y != 1 {
        next_dir_x = 0
        next_dir_y = -1
    }
    if (gui.is_key_down(win, "Down") || gui.is_key_down(win, "S")) && dir_y != -1 {
        next_dir_x = 0
        next_dir_y = 1
    }
    if (gui.is_key_down(win, "Left") || gui.is_key_down(win, "A")) && dir_x != 1 {
        next_dir_x = -1
        next_dir_y = 0
    }
    if (gui.is_key_down(win, "Right") || gui.is_key_down(win, "D")) && dir_x != -1 {
        next_dir_x = 1
        next_dir_y = 0
    }

    # Restart button
    if game_over && gui.is_key_down(win, "R") {
        snake_x = [15, 14, 13]
        snake_y = [15, 15, 15]
        dir_x = 1
        dir_y = 0
        next_dir_x = 1
        next_dir_y = 0
        food_x = rand.int(2, 27)
        food_y = rand.int(4, 27)
        score = 0
        game_over = false
        move_interval = 7
    }

    # 2. Update Snake Movement at Timed Steps
    if !game_over && (frame % move_interval == 0) {
        dir_x = next_dir_x
        dir_y = next_dir_y

        let head_x = snake_x[0] + dir_x
        let head_y = snake_y[0] + dir_y

        # Boundary checks (Play area is x: 0..29, y: 2..29)
        if head_x < 0 || head_x >= 30 || head_y < 2 || head_y >= 30 {
            game_over = true
            if score > high_score {
                high_score = score
            }
        }

        # Self collision check
        let c = 0
        let cur_body_len = len(snake_x)
        while c < cur_body_len {
            if snake_x[c] == head_x && snake_y[c] == head_y {
                game_over = true
                if score > high_score {
                    high_score = score
                }
            }
            c = c + 1
        }

        if !game_over {
            let ate_food = false
            if head_x == food_x && head_y == food_y {
                ate_food = true
                score = score + 10
                food_x = rand.int(2, 27)
                food_y = rand.int(4, 27)
                # Gradually accelerate snake as score rises
                if (score % 50 == 0) && move_interval > 3 {
                    move_interval = move_interval - 1
                }
            }

            # Advance snake body
            let new_x = [head_x]
            let new_y = [head_y]
            let keep_count = cur_body_len
            if !ate_food {
                keep_count = cur_body_len - 1
            }

            let k = 0
            while k < keep_count {
                push(new_x, snake_x[k])
                push(new_y, snake_y[k])
                k = k + 1
            }
            snake_x = new_x
            snake_y = new_y
        }
    }

    # 3. Render Graphics
    # Clear background (Catppuccin Mantle dark)
    gui.clear(win, "#181825")

    # Draw Top HUD
    gui.rect(win, 0, 0, 600, 40, "#1e1e2e")
    gui.line(win, 0, 39, 600, 39, "#313244")
    gui.text(win, 16, 12, "SHAE SNAKE", "#89b4fa", 2)
    gui.text(win, 240, 12, "SCORE: " + str(score), "#a6e3a1", 2)
    gui.text(win, 440, 12, "BEST: " + str(high_score), "#fab387", 2)

    # Playfield border
    gui.rect_outline(win, 1, 41, 598, 558, "#45475a", 2)

    # Draw Apple
    let ax = food_x * 20
    let ay = food_y * 20
    gui.circle(win, ax + 10, ay + 10, 8, "#f38ba8")
    gui.circle(win, ax + 10, ay + 10, 4, "#eba0ac")
    gui.rect(win, ax + 9, ay + 2, 2, 4, "#a6e3a1")

    # Draw Snake Segments
    let total_segs = len(snake_x)
    let s = 0
    while s < total_segs {
        let sx = snake_x[s] * 20
        let sy = snake_y[s] * 20

        if s == 0 {
            # Snake Head
            gui.rect(win, sx + 1, sy + 1, 18, 18, "#a6e3a1")
            gui.rect_outline(win, sx + 1, sy + 1, 18, 18, "#94e2d5", 1)

            # Eyes based on facing direction
            let e1x = sx + 5
            let e1y = sy + 5
            let e2x = sx + 13
            let e2y = sy + 5
            if dir_y == 1 {
                e1y = sy + 13
                e2y = sy + 13
            }
            if dir_x == 1 {
                e1x = sx + 13
                e2x = sx + 13
                e1y = sy + 5
                e2y = sy + 13
            }
            if dir_x == -1 {
                e1x = sx + 5
                e2x = sx + 5
                e1y = sy + 5
                e2y = sy + 13
            }
            gui.pixel(win, e1x, e1y, "#11111b")
            gui.pixel(win, e2x, e2y, "#11111b")
        } else {
            # Snake Body with alternating emerald palette
            let body_color = "#588157"
            if s % 2 == 1 {
                body_color = "#6da368"
            }
            gui.rect(win, sx + 2, sy + 2, 16, 16, body_color)
        }
        s = s + 1
    }

    # Game Over Dialog
    if game_over {
        gui.rect(win, 70, 200, 460, 200, "#11111b")
        gui.rect_outline(win, 70, 200, 460, 200, "#f38ba8", 3)
        gui.text(win, 150, 230, "GAME OVER!", "#f38ba8", 3)
        gui.text(win, 130, 280, "SCORE: " + str(score) + "   RECORD: " + str(high_score), "#cdd6f4", 2)
        gui.text(win, 150, 330, "Press [R] to Play Again", "#a6e3a1", 2)
        gui.text(win, 195, 365, "Press [ESC] to Exit", "#6c7086", 1)
    }

    # 4. Present Frame & Lock 60 FPS
    gui.render(win)
    gui.limit_fps(win, 60)
}

gui.close(win)
println("Thanks for playing Shae Retro Snake!")
