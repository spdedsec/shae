// A simple web server in Shae
let state = { visits: 0 }

fn handler(req) {
    print("Received", req.method, "request to", req.path)
    state.visits += 1
    
    if req.path == "/" {
        return "<h1>Welcome to Shae!</h1><p>Visits: \{state.visits}</p>"
    } else if req.path == "/api" {
        return state
    }
    
    return "404 Not Found"
}

print("Starting Shae server...")
serve(8080, handler)
