        weapon_atk: 0,
        shield_name: "None",
        shield_def: 0,
        turns_taken: 0,
        monsters_slain: 0
    }
}

fn init_game() {
    let colors = init_colors()
    let player = init_player()
    let rooms = build_rooms()
    return Game {
        running: true,
        player: player,
        rooms: rooms,
        colors: colors,
        rng_seed: 424242,
        is_defending: false,
        game_won: false,
        boss_turn_count: 0
    }
}

