    println(c.bold_red +    "  ██╔══██╗██║   ██║████╗  ██║██╔════╝ ██╔════╝██╔═══██╗████╗  ██║" + c.reset)
    println(c.bold_yellow + "  ██║  ██║██║   ██║██╔██╗ ██║██║  ███╗█████╗  ██║   ██║██╔██╗ ██║" + c.reset)
    println(c.bold_yellow + "  ██║  ██║██║   ██║██║╚██╗██║██║   ██║██╔══╝  ██║   ██║██║╚██╗██║" + c.reset)
    println(c.bold_green +  "  ██████╔╝╚██████╔╝██║ ╚████║╚██████╔╝███████╗╚██████╔╝██║ ╚████║" + c.reset)
    println(c.bold_green +  "  ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚══════╝ ╚═════╝ ╚═╝  ╚═══╝" + c.reset)
    println(c.bold_cyan +   "                   O F   S H A E  —  T E R M I N A L   R P G      " + c.reset)
    println(c.bold_yellow + "╚══════════════════════════════════════════════════════════════════╝" + c.reset)
    println(c.white + " Welcome, Brave Adventurer! Type 'help' for commands, 'look' to inspect." + c.reset)
}

fn show_room(game) {
    let c = game.colors
    let room = game.rooms[game.player.current_room]
    println("")
    println(c.bold_magenta + "═══ " + room.name + " ═══" + c.reset)
    println(room.desc)
    
    let exits = []
    if room.north != "" { exits.push("North") }
    if room.south != "" { exits.push("South") }
    if room.east != ""  { exits.push("East") }
    if room.west != ""  { exits.push("West") }
    println(c.cyan + "Exits: " + exits.join(", ") + c.reset)
    
    if room.item != "" && room.item != null {
        println(c.bold_yellow + "You see an item here: " + room.item + c.reset)
    }
    
    if room.enemy != null && room.enemy.alive {
        println(c.bold_red + "⚠ A hostile " + room.enemy.name + " lurks here!" + c.reset)
        println(c.red + room.enemy.description + c.reset)
        println("Enemy HP: " + render_hp_bar(room.enemy.hp, room.enemy.max_hp, 10, c))
    }
}

fn show_inventory(game) {
    let c = game.colors
    let p = game.player
    println("")
    println(c.bold_cyan + "╔═══════════════ INVENTORY ═══════════════╗" + c.reset)
    println(" Weapon: " + c.bold_yellow + p.weapon_name + " (+" + str(p.weapon_atk) + " ATK)" + c.reset)
    println(" Shield: " + c.bold_blue + p.shield_name + " (+" + str(p.shield_def) + " DEF)" + c.reset)
    println(" Potions: " + c.bold_green + str(p.potions) + " remaining" + c.reset)
    println(" Gold: " + c.bold_yellow + str(p.gold) + " coins" + c.reset)
    let inv_str = "None"
    if p.inventory.len > 0 {
        inv_str = p.inventory.join(", ")
    }
    println(" Backpack: " + inv_str)
    println(c.bold_cyan + "╚═════════════════════════════════════════╝" + c.reset)
}

fn show_status(game) {
    let c = game.colors
    let p = game.player
    let total_atk = p.atk + p.weapon_atk
    let total_def = p.def + p.shield_def
    let hp_pct = int_div(p.hp * 100, p.max_hp)
    println("")
    println(c.bold_cyan + "╔══════════════ PLAYER STATUS ══════════════╗" + c.reset)
    println(" Name: " + c.bold_white + p.name + c.reset)
    println(" Health: " + render_hp_bar(p.hp, p.max_hp, 15, c) + " (" + str(hp_pct) + "%)")
    println(" Attack: " + str(total_atk) + " (Base: " + str(p.atk) + ", Weapon: +" + str(p.weapon_atk) + ")")
    println(" Defense: " + str(total_def) + " (Base: " + str(p.def) + ", Shield: +" + str(p.shield_def) + ")")
    println(" Potions: " + str(p.potions))
    println(" Gold: " + str(p.gold))
    println(" Monsters Slain: " + str(p.monsters_slain))
    println(" Turns Taken: " + str(p.turns_taken))
    println(c.bold_cyan + "╚═══════════════════════════════════════════╝" + c.reset)
}

