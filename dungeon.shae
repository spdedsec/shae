#!/usr/bin/env shae
# ==============================================================================
#  DUNGEON OF SHAE — A Pure Shae Interactive Terminal RPG
# ==============================================================================
#  Milestone 3 Implementation for Shae Language & Compiler Project
# ==============================================================================

# ------------------------------------------------------------------------------
# Struct Declarations
# (All declared fields must be explicitly initialized on instantiation)
# ------------------------------------------------------------------------------

struct Colors {
    reset,
    bold,
    red,
    bold_red,
    green,
    bold_green,
    yellow,
    bold_yellow,
    blue,
    bold_blue,
    magenta,
    bold_magenta,
    cyan,
    bold_cyan,
    white,
    bold_white
}

struct Player {
    name,
    hp,
    max_hp,
    atk,
    def,
    potions,
    gold,
    current_room,
    inventory,
    weapon_name,
    weapon_atk,
    shield_name,
    shield_def,
    turns_taken,
    monsters_slain
}

struct Enemy {
    id,
    name,
    hp,
    max_hp,
    atk,
    def,
    is_boss,
    loot_item,
    loot_gold,
    description,
    alive
}

struct Room {
    id,
    name,
    desc,
    north,
    south,
    east,
    west,
    enemy,
    item,
    is_locked,
    required_key
}

struct Game {
    running,
    player,
    rooms,
    colors,
    rng_seed,
    is_defending,
    game_won,
    boss_turn_count
}

# ------------------------------------------------------------------------------
# Initialization & Setup
# ------------------------------------------------------------------------------

fn init_colors() {
    let esc = ""
    return Colors {
        reset: esc + "[0m",
        bold: esc + "[1m",
        red: esc + "[31m",
        bold_red: esc + "[1;31m",
        green: esc + "[32m",
        bold_green: esc + "[1;32m",
        yellow: esc + "[33m",
        bold_yellow: esc + "[1;33m",
        blue: esc + "[34m",
        bold_blue: esc + "[1;34m",
        magenta: esc + "[35m",
        bold_magenta: esc + "[1;35m",
        cyan: esc + "[36m",
        bold_cyan: esc + "[1;36m",
        white: esc + "[37m", bold_white: esc + "[1;37m"
    }
}

fn int_div(a, b) {
    if b == 0 { return 0 }
    let rem = a % b
    return (a - rem) / b
}

fn repeat_str(s, n) {
    let out = ""
    let i = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn has_item(arr, target) {
    for item in arr {
        if item == target {
            return true
        }
    }
    return false
}

fn next_random(seed) {
    let s = (seed * 1103515245 + 12345) % 2147483648
    if s < 0 { s = 0 - s }
    return s
}

fn rand_range(game, min_val, max_val) {
    game.rng_seed = next_random(game.rng_seed)
    let span = (max_val - min_val) + 1
    let r = game.rng_seed % span
    return min_val + r
}

fn render_hp_bar(hp, max_hp, width, c) {
    let cur = hp
    if cur < 0 { cur = 0 }
    let filled = int_div(cur * width, max_hp)
    if filled > width { filled = width }
    let empty = width - filled
    let color = c.bold_green
    if cur <= int_div(max_hp, 4) {
        color = c.bold_red
    } else if cur <= int_div(max_hp, 2) {
        color = c.bold_yellow
    }
    let bar = repeat_str("█", filled) + repeat_str("░", empty)
    return color + "[" + bar + "] " + str(cur) + "/" + str(max_hp) + " HP" + c.reset
}

# ------------------------------------------------------------------------------
# World Map Construction (7 Interconnected Rooms)
# ------------------------------------------------------------------------------

