    let c = game.colors
    println("")
    println(c.bold_yellow + "╔══════════════ COMMAND GUIDE ══════════════╗" + c.reset)
    println(" Exploration:")
    println("   n / north     - Move north")
    println("   s / south     - Move south")
    println("   e / east      - Move east")
    println("   w / west      - Move west")
    println("   look / l      - Inspect current room")
    println("   take / t      - Pick up item in room")
    println(" Combat:")
    println("   attack / a    - Strike target enemy")
    println("   defend / def  - Raise guard (halves incoming damage)")
    println("   potion / p    - Drink health potion (+35 HP)")
    println(" Management:")
    println("   inventory / i - View equipment and bag")
    println("   status        - View player attributes")
    println("   help / h      - Display this command guide")
    println("   quit / q      - Save and exit the dungeon")
    println(c.bold_yellow + "╚═══════════════════════════════════════════╝" + c.reset)
}

fn show_victory_screen(game) {
    let c = game.colors
    println("")
    println(c.bold_yellow + "╔══════════════════════════════════════════════════════════════════╗" + c.reset)
    println(c.bold_green +  "                   ★ ★ ★  V I C T O R Y !  ★ ★ ★                  " + c.reset)
    println(c.bold_yellow + "╚══════════════════════════════════════════════════════════════════╝" + c.reset)
    println(c.bold_green + " With a final earth-shaking roar, Ignis the Dread collapses into ash!" + c.reset)
    println(c.bold_magenta + " You retrieve THE HEART OF SHAE — the legendary relic of eternity!" + c.reset)
    println(c.white + " The dungeon trembles and light restores peace across the land." + c.reset)
    println("")
    println(c.bold_cyan + "Final Stats:" + c.reset)
    println(" - Monsters Slain: " + str(game.player.monsters_slain))
    println(" - Gold Collected: " + str(game.player.gold))
    println(" - Turns Taken: " + str(game.player.turns_taken))
    println(" - Final Weapon: " + game.player.weapon_name)
    println(" - Final Shield: " + game.player.shield_name)
    println(c.bold_yellow + "Thank you for playing Dungeon of Shae!" + c.reset)
    println("")
}

fn show_defeat_screen(game) {
    let c = game.colors
    println("")
    println(c.bold_red + "╔══════════════════════════════════════════════════════════════════╗" + c.reset)
    println(c.bold_red + "                   ☠ ☠ ☠  Y O U   H A V E   F A L L E N  ☠ ☠ ☠     " + c.reset)
    println(c.bold_red + "╚══════════════════════════════════════════════════════════════════╝" + c.reset)
    println(c.red + " Your vision fades to darkness as the dungeon claims another soul..." + c.reset)
    println(c.white + " Better luck next time, brave adventurer." + c.reset)
    println("")
}

fn check_player_alive(game) {
    let c = game.colors
    if game.player.hp <= 0 {
        game.player.hp = 0
        println("")
        println(render_hp_bar(game.player.hp, game.player.max_hp, 15, c))
        show_defeat_screen(game)
        game.running = false
    } else {
        println("Your HP: " + render_hp_bar(game.player.hp, game.player.max_hp, 15, c))
    }
}

# ------------------------------------------------------------------------------
# Combat Engine & Enemy AI
# ------------------------------------------------------------------------------

fn enemy_turn(game, enemy) {
    let c = game.colors
    game.player.turns_taken = game.player.turns_taken + 1
    
    # Boss special attack: Every 3rd turn
    if enemy.is_boss {
        game.boss_turn_count = game.boss_turn_count + 1
        if game.boss_turn_count % 3 == 0 {
            println(c.bold_red + "🔥 " + enemy.name + " unleashes CATACLYSMIC FLAME BREATH! 🔥" + c.reset)
            let flame_dmg = 28
            if game.is_defending {
                flame_dmg = 10
                println(c.bold_blue + "🛡 Your shield absorbs the inferno! Damage reduced to " + str(flame_dmg) + "!" + c.reset)
            } else {
                println(c.bold_red + "The roaring dragonfire engulfs you for " + str(flame_dmg) + " damage!" + c.reset)
            }
            game.player.hp = game.player.hp - flame_dmg
            game.is_defending = false
            check_player_alive(game)
            return null
        }
    }
    
    # Standard enemy strike with defense mitigation
    let total_def = game.player.def + game.player.shield_def
    let raw_atk = enemy.atk - total_def
    if raw_atk < 1 { raw_atk = 1 }
    let e_dmg = raw_atk + rand_range(game, -1, 1)
    if e_dmg < 1 { e_dmg = 1 }
    
    if game.is_defending {
        e_dmg = int_div(e_dmg, 2)
        if e_dmg < 1 { e_dmg = 1 }
        println(c.bold_blue + "🛡 You brace your shield! Incoming damage halved to " + str(e_dmg) + "!" + c.reset)
    } else {
        println(c.bold_red + "🩸 The " + enemy.name + " attacks you for " + str(e_dmg) + " damage!" + c.reset)
    }
    game.player.hp = game.player.hp - e_dmg
    game.is_defending = false
    
    check_player_alive(game)
}

fn do_attack(game) {
    let c = game.colors
    let room = game.rooms[game.player.current_room]
    if room.enemy == null || !room.enemy.alive {
        println("There is nothing here to attack.")
        return null
    }
    let enemy = room.enemy
    let total_atk = game.player.atk + game.player.weapon_atk
    let raw_dmg = total_atk - enemy.def
    if raw_dmg < 1 { raw_dmg = 1 }
    let variance = rand_range(game, -1, 2)
    let dmg = raw_dmg + variance
    if dmg < 1 { dmg = 1 }
    
    # 15% Critical Hit chance dealing 1.5x damage
    let is_crit = rand_range(game, 1, 100) <= 15
    if is_crit {
        dmg = int_div(dmg * 3, 2)
        println(c.bold_yellow + "★ CRITICAL HIT! ★" + c.reset)
    }
    
    enemy.hp = enemy.hp - dmg
    println(c.bold_green + "⚔ You strike the " + enemy.name + " for " + str(dmg) + " damage!" + c.reset)
    
    if enemy.hp <= 0 {
        enemy.hp = 0
        enemy.alive = false
        game.player.monsters_slain = game.player.monsters_slain + 1
        game.player.gold = game.player.gold + enemy.loot_gold
        println(c.bold_green + "☠ You have slain the " + enemy.name + "! Found " + str(enemy.loot_gold) + " gold." + c.reset)
        
        if enemy.loot_item != "" && enemy.loot_item != null {
            println(c.bold_yellow + "The " + enemy.name + " dropped: " + enemy.loot_item + "!" + c.reset)
            game.player.inventory.push(enemy.loot_item)
            if enemy.loot_item == "Reinforced Shield" {
                game.player.shield_name = "Reinforced Shield"
                game.player.shield_def = 5
                println(c.bold_blue + "Equipped Reinforced Shield (+5 DEF)!" + c.reset)
            }
            if enemy.loot_item == "The Heart of Shae" {
                game.game_won = true
                show_victory_screen(game)
                game.running = false
            }
        }
        return null
    }
    
    println("Enemy HP: " + render_hp_bar(enemy.hp, enemy.max_hp, 10, c))
    enemy_turn(game, enemy)
}

fn do_defend(game) {
    let c = game.colors
    let room = game.rooms[game.player.current_room]
    if room.enemy == null || !room.enemy.alive {
        println("There is no threat here to defend against.")
        return null
    }
    game.is_defending = true
    println(c.bold_blue + "You take a defensive stance, raising your guard!" + c.reset)
    enemy_turn(game, room.enemy)
}

fn do_potion(game) {
    let c = game.colors
    if game.player.potions <= 0 {
        println(c.bold_yellow + "You have no potions left!" + c.reset)
        return null
    }
    game.player.potions = game.player.potions - 1
    let heal = 35
    let old_hp = game.player.hp
    game.player.hp = game.player.hp + heal
    if game.player.hp > game.player.max_hp {
        game.player.hp = game.player.max_hp
    }
    let actual_heal = game.player.hp - old_hp
    println(c.bold_green + "🧪 You drink a Health Potion and restore " + str(actual_heal) + " HP! (Potions left: " + str(game.player.potions) + ")" + c.reset)
    println("Your HP: " + render_hp_bar(game.player.hp, game.player.max_hp, 15, c))
    
    let room = game.rooms[game.player.current_room]
    if room.enemy != null && room.enemy.alive {
        enemy_turn(game, room.enemy)
    }
}

# ------------------------------------------------------------------------------
# Item Management & Movement Handlers
# ------------------------------------------------------------------------------

fn do_take(game) {
    let c = game.colors
    let room = game.rooms[game.player.current_room]
    if room.item == "" || room.item == null {
        println("There is nothing here to take.")
        return null
    }
    let item = room.item
    room.item = ""
    
    if item == "Wooden Torch" {
        game.player.weapon_name = "Wooden Torch"
        game.player.weapon_atk = 1
        game.player.inventory.push(item)
        println(c.bold_green + "You pick up the Wooden Torch (+1 ATK)!" + c.reset)
    } else if item == "Steel Broadsword" {
        game.player.weapon_name = "Steel Broadsword"
        game.player.weapon_atk = 10
        game.player.inventory.push(item)
        println(c.bold_green + "You equip the Steel Broadsword (+10 ATK)!" + c.reset)
    } else if item == "Reinforced Shield" {
        game.player.shield_name = "Reinforced Shield"
        game.player.shield_def = 5
        game.player.inventory.push(item)
        println(c.bold_blue + "You equip the Reinforced Shield (+5 DEF)!" + c.reset)
    } else if item == "Health Potion" {
        game.player.potions = game.player.potions + 1
        game.player.inventory.push(item)
        println(c.bold_green + "You pick up a Health Potion! (Total potions: " + str(game.player.potions) + ")" + c.reset)
    } else if item == "Greater Healing Potion" {
        game.player.potions = game.player.potions + 2
        game.player.inventory.push(item)
        println(c.bold_green + "You pick up a Greater Healing Potion! (+2 Potions, Total: " + str(game.player.potions) + ")" + c.reset)
    } else if item == "Dragonfire Elixir" {
        game.player.inventory.push(item)
        game.player.atk = game.player.atk + 6
        game.player.max_hp = game.player.max_hp + 15
        game.player.hp = game.player.max_hp
        println(c.bold_magenta + "✦ You drink the legendary Dragonfire Elixir! ✦" + c.reset)
        println(c.bold_green + "Permanent Boost: +6 ATK, +15 Max HP! Fully healed to " + str(game.player.max_hp) + " HP!" + c.reset)
    } else {
        game.player.inventory.push(item)
        println(c.bold_yellow + "You took: " + item + c.reset)
    }
}

fn do_move(game, direction) {
    let c = game.colors
    let current = game.rooms[game.player.current_room]
    
    if current.enemy != null && current.enemy.alive {
        println(c.bold_red + "The " + current.enemy.name + " blocks your escape! You must defeat it to proceed." + c.reset)
        return null
    }
    
    let target_id = ""
    if direction == "north" {
        target_id = current.north
    } else if direction == "south" {
        target_id = current.south
    } else if direction == "east" {
        target_id = current.east
    } else if direction == "west" {
        target_id = current.west
    }
    
    if target_id == "" {
        println(c.bold_red + "You cannot go " + direction + " from here." + c.reset)
        return null
    }
    
    let target_room = game.rooms[target_id]
    if target_room.is_locked {
        if has_item(game.player.inventory, target_room.required_key) {
            target_room.is_locked = false
            println(c.bold_yellow + "You insert the " + target_room.required_key + " and hear a heavy metallic click!" + c.reset)
            println(c.bold_green + "The portal into " + target_room.name + " swings open!" + c.reset)
        } else {
            println(c.bold_red + "The entrance to " + target_room.name + " is locked! It requires: " + target_room.required_key + "." + c.reset)
            return null
        }
    }
    
    game.player.current_room = target_id
    game.player.turns_taken = game.player.turns_taken + 1
    show_room(game)
}

fn do_quit(game) {
    println(game.colors.bold_yellow + "You retreat from the dungeon. Farewell, adventurer!" + game.colors.reset)
    game.running = false
}

# ------------------------------------------------------------------------------
# Command Parser & Match Arm Dispatch
# (Match arms are expressions calling functions, never statement blocks)
# ------------------------------------------------------------------------------

fn resolve_action(raw) {
    let s = raw.trim().lower()
    return match s {
        "n" => "go_north",
        "north" => "go_north",
        "go north" => "go_north",
        "move north" => "go_north",
        "s" => "go_south",
        "south" => "go_south",
        "go south" => "go_south",
        "move south" => "go_south",
        "e" => "go_east",
        "east" => "go_east",
        "go east" => "go_east",
        "move east" => "go_east",
        "w" => "go_west",
        "west" => "go_west",
        "go west" => "go_west",
        "move west" => "go_west",
        "a" => "attack",
        "att" => "attack",
        "attack" => "attack",
        "fight" => "attack",
        "strike" => "attack",
        "hit" => "attack",
        "kill" => "attack",
        "def" => "defend",
        "defend" => "defend",
        "block" => "defend",
        "guard" => "defend",
        "p" => "potion",
        "pot" => "potion",
        "potion" => "potion",
        "heal" => "potion",
        "use potion" => "potion",
        "drink potion" => "potion",
        "drink" => "potion",
        "t" => "take",
        "take" => "take",
        "pickup" => "take",
        "pick up" => "take",
        "grab" => "take",
        "get" => "take",
        "loot" => "take",
        "i" => "inventory",
        "inv" => "inventory",
        "inventory" => "inventory",
        "bag" => "inventory",
        "items" => "inventory",
        "l" => "look",
        "look" => "look",
        "examine" => "look",
        "inspect" => "look",
        "search" => "look",
        "status" => "status",
        "stats" => "status",
        "stat" => "status",
        "me" => "status",
        "c" => "status",
        "h" => "help",
        "help" => "help",
        "?" => "help",
        "commands" => "help",
        "q" => "quit",
        "quit" => "quit",
        "exit" => "quit",
        _ => "unknown"
    }
}

fn handle_command(game, raw) {
    let action = resolve_action(raw)
    match action {
        "go_north" => do_move(game, "north"),
        "go_south" => do_move(game, "south"),
        "go_east"  => do_move(game, "east"),
        "go_west"  => do_move(game, "west"),
        "attack"   => do_attack(game),
        "defend"   => do_defend(game),
        "potion"   => do_potion(game),
        "take"     => do_take(game),
        "inventory"=> show_inventory(game),
        "look"     => show_room(game),
        "status"   => show_status(game),
        "help"     => show_help(game),
        "quit"     => do_quit(game),
        _          => println("Unknown command: '" + raw + "'. Type 'help' for available commands.")
    }
}

# ------------------------------------------------------------------------------
# Automated Walkthrough Mode (SHAE_DEMO=1)
# ------------------------------------------------------------------------------

fn run_automated_walkthrough(game) {
    let c = game.colors
    println(c.bold_cyan + "==================================================================" + c.reset)
    println(c.bold_yellow + "     DUNGEON OF SHAE — AUTOMATED DEMO WALKTHROUGH MODE           " + c.reset)
    println(c.bold_cyan + "==================================================================" + c.reset)
    
    show_room(game)
    
    # Step 1: In Dungeon Entrance - take Torch and move North
    println("\n" + c.bold_cyan + "[Demo Action]> take" + c.reset)
    handle_command(game, "take")
    
    println("\n" + c.bold_cyan + "[Demo Action]> north" + c.reset)
    handle_command(game, "north")
    
    # Step 2: In Hall of Shadows - defeat Shadow Lurker and take Bronze Key
    while game.rooms["hall"].enemy.alive && game.player.hp > 0 {
        println("\n" + c.bold_cyan + "[Demo Action]> attack" + c.reset)
        handle_command(game, "attack")
    }
    
    println("\n" + c.bold_cyan + "[Demo Action]> take" + c.reset)
    handle_command(game, "take")
    
    # Step 3: Enter Ancient Armory - defeat Skeleton Guardian, equip Shield & Broadsword
    println("\n" + c.bold_cyan + "[Demo Action]> east" + c.reset)
    handle_command(game, "east")
    
    while game.rooms["armory"].enemy.alive && game.player.hp > 0 {
        println("\n" + c.bold_cyan + "[Demo Action]> attack" + c.reset)
        handle_command(game, "attack")
    }
    
    println("\n" + c.bold_cyan + "[Demo Action]> take" + c.reset)
    handle_command(game, "take")
    
    # Step 4: Return to Hall, then head west to Arcane Archives
    println("\n" + c.bold_cyan + "[Demo Action]> west" + c.reset)
    handle_command(game, "west")
    
    println("\n" + c.bold_cyan + "[Demo Action]> west" + c.reset)
    handle_command(game, "west")
    
    # Step 5: In Arcane Archives - defeat Wraith of the Lost, take Greater Potion
    while game.rooms["library"].enemy.alive && game.player.hp > 0 {
        println("\n" + c.bold_cyan + "[Demo Action]> attack" + c.reset)
        handle_command(game, "attack")
    }
    
    println("\n" + c.bold_cyan + "[Demo Action]> take" + c.reset)
    handle_command(game, "take")
    
    # Step 6: Unlock and visit Alchemist's Laboratory - drink Dragonfire Elixir
    println("\n" + c.bold_cyan + "[Demo Action]> north" + c.reset)
    handle_command(game, "north")
    
    println("\n" + c.bold_cyan + "[Demo Action]> take" + c.reset)
    handle_command(game, "take")
    
    # Step 7: Return to Library, then Hall, then North to Crypt
    println("\n" + c.bold_cyan + "[Demo Action]> south" + c.reset)
    handle_command(game, "south")
    
    println("\n" + c.bold_cyan + "[Demo Action]> east" + c.reset)
    handle_command(game, "east")
    
    println("\n" + c.bold_cyan + "[Demo Action]> north" + c.reset)
    handle_command(game, "north")
    
    # Step 8: In Crypt of the Forgotten - defeat Crypt Ghoul (drops Gold Dragon Key), take Health Potion
    while game.rooms["crypt"].enemy.alive && game.player.hp > 0 {
        println("\n" + c.bold_cyan + "[Demo Action]> attack" + c.reset)
        handle_command(game, "attack")
    }
    
    println("\n" + c.bold_cyan + "[Demo Action]> take" + c.reset)
    handle_command(game, "take")
    
    if game.player.hp < 70 && game.player.potions > 0 {
        println("\n" + c.bold_cyan + "[Demo Action]> potion" + c.reset)
        handle_command(game, "potion")
    }
    
    # Step 9: Unlock and Enter Dragon's Sanctum - defeat Boss Ignis the Dread!
    println("\n" + c.bold_cyan + "[Demo Action]> north" + c.reset)
    handle_command(game, "north")
    
    while game.rooms["sanctum"].enemy.alive && game.player.hp > 0 {
        if game.boss_turn_count % 3 == 2 {
            println("\n" + c.bold_cyan + "[Demo Action]> defend" + c.reset)
            handle_command(game, "defend")
        } else if game.player.hp < 40 && game.player.potions > 0 {
            println("\n" + c.bold_cyan + "[Demo Action]> potion" + c.reset)
            handle_command(game, "potion")
        } else {
            println("\n" + c.bold_cyan + "[Demo Action]> attack" + c.reset)
            handle_command(game, "attack")
        }
    }
    
    println(c.bold_green + "Automated Walkthrough completed successfully!" + c.reset)
}

# ------------------------------------------------------------------------------
# Main Interactive Loop Entry Point
# ------------------------------------------------------------------------------

fn main() {
    let game = init_game()
    let is_demo = env("SHAE_DEMO")
    if is_demo == "1" || is_demo == "true" {
        run_automated_walkthrough(game)
        return null
    }

    show_title_banner(game.colors)
    show_room(game)

    let consecutive_empty = 0
    while game.running {
        let prompt_str = game.colors.bold_cyan + "\n[Dungeon of Shae]> " + game.colors.reset
        let line = input(prompt_str)
        if line == null || line.trim() == "" {
            consecutive_empty = consecutive_empty + 1
            if consecutive_empty >= 2 {
                println(game.colors.bold_yellow + "\nEnd of input detected. Exiting Dungeon of Shae. Farewell!" + game.colors.reset)
                game.running = false
                break
            }
            println(game.colors.bold_yellow + "Type 'help' for commands, 'quit' to exit." + game.colors.reset)
            continue
        }
        consecutive_empty = 0
        handle_command(game, line)
        if game.game_won || game.player.hp <= 0 {
            game.running = false
            break
        }
    }
}

main()
