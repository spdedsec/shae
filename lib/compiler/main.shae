// Shae Self-Hosting Compiler Suite: Unified Compiler Driver Entrypoint
// lib/compiler/main.shae
//
// Orchestrates the entire pure-Shae compilation toolchain:
// - Lexer & Pratt Parser (token.shae, ast.shae, lexer.shae, parser.shae)
// - Bytecode Generator & Serializer (opcode.shae, chunk.shae, codegen.shae)
// - Disassembler (disasm.shae)
// - Native Object Linker for ELF and PE/COFF (elf.shae, pe.shae, linker.shae)
// - WebAssembly Binary Emitter (wasm.shae)

use { tokenize } from "./lexer.shae"
use { parse } from "./parser.shae"
use { compile_program, compile_source_to_chunk, compile_file_to_shaec } from "./codegen.shae"
use { serialize_chunk } from "./chunk.shae"
use { disassemble_chunk } from "./disasm.shae"
use { link_file, link_source_to_elf, link_source_to_pe } from "./linker.shae"
use {
    make_wasm_module,
    wasm_add_type,
    wasm_add_function,
    wasm_add_export,
    build_wasm_binary,
    emit_wasm_file,
    TYPE_I32,
    EXPORT_FUNC
} from "./wasm.shae"
use { read, write_bytes, exists } from "std:fs"
use { platform, args } from "std:sys"

fn compile_to_bytecode(input_path, output_path) {
    let out_file = output_path
    if out_file == null {
        out_file = input_path + "c"
    }
    return compile_file_to_shaec(input_path, out_file)
}

fn disassemble_bytecode(input_path) {
    let src = read(input_path)
    let chunk = compile_source_to_chunk(src)
    return disassemble_chunk(chunk, input_path)
}

fn link_to_native(input_path, output_path, format, stub_path, arch) {
    let out_file = output_path
    if out_file == null {
        out_file = input_path + ".bin"
    }
    return link_file(input_path, out_file, format, stub_path, arch)
}

fn compile_to_wasm(input_path, output_path) {
    let out_file = output_path
    if out_file == null {
        out_file = input_path + ".wasm"
    }

    let src = read(input_path)
    let tokens = tokenize(src)
    let ast = parse(tokens)

    let m = make_wasm_module()
    let fn_type_idx = wasm_add_type(m, [], [TYPE_I32])

    let func_count = 0
    let i = 0
    while i < ast.statements.len {
        let stmt = ast.statements[i]
        if stmt.type == "fn" {
            let code_body = [65, 42]
            let fidx = wasm_add_function(m, fn_type_idx, 0, code_body)
            wasm_add_export(m, stmt.name, EXPORT_FUNC, fidx)
            func_count = func_count + 1
        }
        i = i + 1
    }

    if func_count == 0 {
        let code_body = [65, 0]
        let fidx = wasm_add_function(m, fn_type_idx, 0, code_body)
        wasm_add_export(m, "main", EXPORT_FUNC, fidx)
    }

    let bytes = build_wasm_binary(m)
    emit_wasm_file(out_file, bytes)
    return bytes.len
}

fn driver_dispatch(action, input_path, output_path, format) {
    if action == "compile" {
        return compile_to_bytecode(input_path, output_path)
    } else if action == "disasm" {
        return disassemble_bytecode(input_path)
    } else if action == "link" {
        return link_to_native(input_path, output_path, format, null, null)
    } else if action == "wasm" {
        return compile_to_wasm(input_path, output_path)
    } else {
        return "Unknown compiler action: " + action
    }
}


fn run_cli_driver() {
    let argv = args()
    if argv.len == 0 {
        return null
    }

    let prog = argv[0]
    let is_shaec = prog.contains("shaec") or prog.ends_with("shaec") or prog.ends_with("shaec.exe")
    let is_stage2_or_bytecode = (argv.len > 1 and (argv[1].ends_with(".shaec") or argv[1].contains("shaec_stage2")))
    let is_direct_compiler_script = (argv.len > 1 and (argv[1].ends_with("lib/compiler/main.shae") or argv[1] == "lib/compiler/main.shae" or argv[1] == "./lib/compiler/main.shae"))

    if not is_shaec and not is_stage2_or_bytecode and not is_direct_compiler_script {
        return null
    }

    let start_idx = 1
    if is_direct_compiler_script or is_stage2_or_bytecode {
        start_idx = 2
    }

    if argv.len <= start_idx {
        println("Shae Compiler Driver (shaec)")
        println("Usage: shaec [compile|disasm|link|wasm] <input.shae> [-o <output>]")
        return 0
    }

    let first_arg = argv[start_idx]
    let action = "compile"
    let input_path = null
    let output_path = null
    let format = "elf"

    let i = start_idx
    if first_arg == "compile" or first_arg == "disasm" or first_arg == "link" or first_arg == "wasm" {
        action = first_arg
        i = i + 1
    }

    while i < argv.len {
        let arg = argv[i]
        if (arg == "-o" or arg == "--output") and i + 1 < argv.len {
            output_path = argv[i + 1]
            i = i + 2
        } else if (arg == "-f" or arg == "--format") and i + 1 < argv.len {
            format = argv[i + 1]
            i = i + 2
        } else if input_path == null {
            input_path = arg
            i = i + 1
        } else if output_path == null {
            output_path = arg
            i = i + 1
        } else {
            i = i + 1
        }
    }

    if input_path == null {
        println("Error: No input file specified")
        return 1
    }

    let res = driver_dispatch(action, input_path, output_path, format)
    if action == "compile" {
        let out_target = output_path
        if out_target == null {
            out_target = input_path + "c"
        }
        println("✨ Compiled '", input_path, "' -> '", out_target, "' (", res, " bytes)")
    } else if action == "disasm" {
        println(res)
    } else if action == "link" {
        let out_target = output_path
        if out_target == null {
            out_target = input_path + ".bin"
        }
        println("⚡ Successfully linked standalone binary: ", out_target, " (", res, " bytes)")
    } else if action == "wasm" {
        let out_target = output_path
        if out_target == null {
            out_target = input_path + ".wasm"
        }
        println("✨ Compiled WebAssembly binary: ", out_target, " (", res, " bytes)")
    }
    return 0
}

run_cli_driver()
